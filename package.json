{
  "name": "islamic-reels-creator",
  "private": true,
  "version": "1.0.0",
  "description": "High-performance browser studio for creating stunning Quran verse reels for Instagram, TikTok & YouTube Shorts with authentic Thuluth calligraphy, classical Qari recitations, continuous cinematic camera motion, and hardware-accelerated 1080p MP4 export.",
  "keywords": [
    "quran",
    "islamic-reels",
    "quran-reels",
    "quran-video-generator",
    "thuluth-calligraphy",
    "arabic-typography",
    "quran-recitations",
    "video-editor",
    "webcodecs",
    "mp4-muxer",
    "react19",
    "typescript",
    "vite",
    "everyayah",
    "alquran-cloud",
    "social-media-video"
  ],
  "author": "Islamic Reels Studio",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "mp4-muxer": "^5.2.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
