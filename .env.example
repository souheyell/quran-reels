# ==============================================================================
# Islamic Reels Creator & Bulk Publisher — Environment Configuration Template
# Copy this file to .env or .env.local to configure your credentials.
# NEVER commit your real .env file or access tokens to GitHub!
# ==============================================================================

# Meta / Facebook Graph API Credentials
# Used for fetching Facebook Pages & Instagram accounts
VITE_META_APP_ID=YOUR_META_APP_ID
VITE_META_USER_ACCESS_TOKEN=YOUR_USER_ACCESS_TOKEN
VITE_FB_PAGE_ACCESS_TOKEN=YOUR_PAGE_ACCESS_TOKEN

# YouTube Data API v3 Credentials (Shorts Dispatch)
VITE_YOUTUBE_API_KEY=YOUR_GOOGLE_API_KEY
VITE_YOUTUBE_ACCESS_TOKEN=YOUR_YOUTUBE_OAUTH_ACCESS_TOKEN

# Python CLI & Cloud Bridge Settings (Optional)
FB_PAGE_ID=YOUR_DEFAULT_FACEBOOK_PAGE_ID
META_ACCESS_TOKEN=YOUR_PAGE_ACCESS_TOKEN
PORT=3001
